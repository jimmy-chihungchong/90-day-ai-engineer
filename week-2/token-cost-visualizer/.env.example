# Backend: "local" (LM Studio) or "nim" (NVIDIA NIM). Can also be switched in the UI sidebar.
# On a cloud deploy set BACKEND=nim; the LM Studio option is then hidden.
BACKEND=local

# --- Local: LM Studio (OpenAI-compatible server) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_CHAT_MODEL=openai/gpt-oss-20b
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Online: NVIDIA NIM (get a free key at build.nvidia.com; never commit .env) ---
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
# Verified working on 2026-10-13 (NIM lists ~80 models but most return 404; availability changes).
NIM_CHAT_MODEL=nvidia/ising-calibration-1.5-31b
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Optional: comma-separated model choices shown in the UI (defaults to the verified list in tokviz/config.py)
# NIM_CHAT_MODELS=nvidia/ising-calibration-1.5-31b,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b

# Seconds of silence before we warn and suggest another model
LLM_TIMEOUT_SECONDS=45
