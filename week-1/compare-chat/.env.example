# Backend: "local" (LM Studio) or "nim" (NVIDIA NIM). Can also be switched in the UI.
BACKEND=local

# --- Local: LM Studio (OpenAI-compatible server) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL_A=microsoft/phi-4-mini-reasoning
LMSTUDIO_MODEL_B=llama-3.2-3b-instruct

# --- Online: NVIDIA NIM (key provided later; never commit .env) ---
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
# phi-4-mini-reasoning (404) and llama-3.2-3b-instruct (410, retired) are not available on NIM.
# These are the verified substitutes (reasoning + instruct).
NIM_MODEL_A=openai/gpt-oss-20b
NIM_MODEL_B=meta/muse-glimmer-30b

# Seconds of silence before we warn and suggest the other model
LLM_TIMEOUT_SECONDS=45
