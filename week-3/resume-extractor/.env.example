# Which backend to use: "lmstudio" (local dev) or "nim" (Streamlit deployment)
LLM_BACKEND=lmstudio

# --- LM Studio (local) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio

# --- NVIDIA NIM (hosted) ---
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=openai/gpt-oss-20b   # see scripts/check_nim.py for alternatives
NIM_API_KEY=            # nvapi-... (never commit)

# Seconds to wait for the LLM before alerting and suggesting a fallback model
LLM_TIMEOUT_SECONDS=90
