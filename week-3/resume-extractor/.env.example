# Which backend to use: "lmstudio" (local dev) or "nim" (Streamlit deployment)
LLM_BACKEND=lmstudio

# --- LM Studio (local) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_API_KEY=lm-studio

# --- NVIDIA NIM (hosted) ---
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=openai/gpt-oss-20b   # see scripts/check_nim.py for alternatives
NIM_API_KEY=            # nvapi-... (never commit)

# Seconds to wait for the LLM before alerting and suggesting a fallback model
LLM_TIMEOUT_SECONDS=90

# Output token budget per request. Reasoning models think before answering; if the reply comes back
# empty, the client retries once with double this value.
LLM_MAX_TOKENS=8192

# Max resume characters sent to the model (about 4 chars per token). Longer resumes keep the first 70%
# and the last 30% and show a warning. Default 60000 suits NIM (128k context). LM Studio loads models
# with a small context by default (8192 tokens for gpt-oss-20b on this machine): either raise the
# model's Context Length in LM Studio, or set this to about 20000 when running locally.
MAX_RESUME_CHARS=60000
