# Which backend to use: lmstudio (local) or nvidia (NVIDIA NIM, for Streamlit deployment)
PROVIDER=lmstudio

# --- LM Studio (OpenAI-compatible) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=openai/gpt-oss-20b
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- NVIDIA NIM ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# Seconds to wait for the LLM before warning you and suggesting another model
LLM_TIMEOUT_SECONDS=60
# Default folder of notes to index (.md / .txt / .json)
NOTES_DIR=./sample_notes
